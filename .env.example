# ============================================================================
# TDX AI VOICE + WHATSAPP BOT - CONFIGURACIÓN COMPLETA
# ============================================================================

# ============================================================================
# TELNYX INTEGRATION CONFIGURATION
# ============================================================================

# Feature Flags principales
USE_TELNYX_INSTEAD_OF_LIVEKIT=true
WHATSAPP_BOT_ENABLED=true
WHATSAPP_FALLBACK_ENABLED=true

# 🆕 NUEVA FUNCIONALIDAD: Conversaciones automáticas para webhooks
# Habilitar creación automática de conversaciones cuando se recibe contact_created de landing_page
CREATE_WEBHOOK_CONVERSATIONS_ENABLED=true

# Telnyx API Configuration  
TELNYX_API_KEY=YOUR_TELNYX_API_KEY
TELNYX_CONNECTION_ID=YOUR_CONNECTION_ID
TELNYX_ASSISTANT_ID=assistant-7c5a5a6b-e772-4f7c-a9af-feef3001adba
TELNYX_OUTBOUND_NUMBER=+13052131234

# Telnyx Call Configuration
TELNYX_CALL_TIMEOUT_SECONDS=30
TELNYX_MAX_CALL_DURATION=300

# ============================================================================
# WHATSAPP BOT CONFIGURATION - HOMOLOGADO CON BOT DE VOZ
# ============================================================================

# WhatsApp Bot Feature Flags
WHATSAPP_AGGRESSIVE_MODE=true
WHATSAPP_QUALIFICATION_ENABLED=true
WHATSAPP_AUTO_TRANSFER_KEYWORDS=true
WHATSAPP_ULTRA_DIRECT_FLOW=true

# Rate Limiting optimizado para ventas agresivas
WHATSAPP_RATE_LIMIT_SECONDS=3

# Chatwoot WhatsApp Integration
CHATWOOT_BOT_WEBHOOK_TOKEN=secure-whatsapp-token-production-2025
CHATWOOT_BOT_AGENT_ID=YOUR_BOT_AGENT_ID
CHATWOOT_WHATSAPP_INBOX_ID=YOUR_WHATSAPP_INBOX_ID

# ============================================================================
# CHATWOOT INTEGRATION (SHARED)
# ============================================================================

# Chatwoot API Configuration
VITE_CHATWOOT_ACCOUNT_ID=YOUR_ACCOUNT_ID
VITE_CHATWOOT_API_TOKEN=YOUR_API_TOKEN
VITE_CHATWOOT_INBOX_ID=YOUR_INBOX_ID
CHATWOOT_WEBHOOK_TOKEN=your-secure-token-here

# 🆕 NUEVA CONFIGURACIÓN: Inbox específico para conversaciones de webhook
# Este inbox se usará para crear conversaciones automáticas cuando se reciban webhooks de contact_created
# Configurar con el ID del inbox watdxv3 asociado a WhatsApp
CHATWOOT_WEBHOOK_INBOX_ID=watdxv3_inbox_id_here

# ============================================================================
# MICROSOFT GRAPH INTEGRATION (SHARED)
# ============================================================================

# Microsoft Graph API for Calendar/Meetings
MICROSOFT_GRAPH_CLIENT_ID=YOUR_CLIENT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=YOUR_CLIENT_SECRET
MICROSOFT_GRAPH_TENANT_ID=YOUR_TENANT_ID

# ============================================================================
# OPENAI INTEGRATION (SHARED)
# ============================================================================

# OpenAI API Key for both voice and WhatsApp bots
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================

# Webhook Server Configuration
WEBHOOK_PORT=8000
WEBHOOK_HOST=0.0.0.0
WEBHOOK_BASE_URL=https://your-domain.com

# ============================================================================
# LIVEKIT CONFIGURATION (LEGACY - MANTENER PARA COMPATIBILIDAD)
# ============================================================================

# LiveKit Configuration (legacy support)
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_SECRET
LIVEKIT_URL=wss://your-livekit-url

# SIP Configuration
SIP_OUTBOUND_TRUNK_ID=ST_G24Bo8JH4iy7

# ============================================================================
# RENDER DEPLOYMENT CONFIGURATION
# ============================================================================

# Render specific environment variables
PYTHON_VERSION=3.12.0
PIP_NO_CACHE_DIR=1
PORT=8000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Security settings
CHATWOOT_ALLOWED_IPS=127.0.0.1,your-production-ip
TELNYX_WEBHOOK_SIGNING_SECRET=YOUR_WEBHOOK_SECRET

# ============================================================================
# MONITORING AND LOGGING
# ============================================================================

# Logging level
LOG_LEVEL=INFO

# Monitoring flags
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_CONVERSATION_ANALYTICS=true

# ============================================================================
# HOMOLOGACIÓN CONFIGURATION - NUEVAS VARIABLES
# ============================================================================

# Variables específicas para homologación de bots
BOT_PERSONALITY_MODE=aggressive
BOT_CONVERSATION_MAX_TURNS=3
BOT_AUTO_QUALIFY_ENABLED=true
BOT_TRANSFER_KEYWORDS_STRICT=true

# Fallback configuration
VOICE_TO_WHATSAPP_FALLBACK=true
FALLBACK_MESSAGE_TEMPLATE=custom
WHATSAPP_PROACTIVE_MESSAGING=true

# Performance optimization
MAX_MESSAGE_LENGTH=500
TYPING_INDICATOR_DURATION=1000